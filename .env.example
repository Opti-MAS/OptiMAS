# ─── OptiMAS Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored and will NOT be committed.

# ─── MCP Server ───────────────────────────────────────────────────────
# Must match one of the keys in optimas_server/config.yaml (auth.api_keys).
MCP_API_KEY="optimas-local-dev-key"
OPTIMAS_SESSION_SECRET=""

# ─── LLM Provider Keys ───────────────────────────────────────────────
# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_BASE_URL=""

# ─── Local / Self-Hosted Models ──────────────────────────────────────
# When model_name starts with "local_", the client uses these credentials
# and strips the "local_" prefix before sending to the inference server.
LOCAL_LLM_BASE_URL="http://127.0.0.1:8000/v1"
LOCAL_LLM_API_KEY="local"

# ─── Networking ──────────────────────────────────────────────────────
# Set to "false" only if your provider endpoint uses a self-signed certificate.
LLM_VERIFY_SSL="true"
NO_PROXY="127.0.0.1,localhost,::1"

# Timeouts, model routing and API-usage recording are configured in YAML,
# not here: see optimas_client/config/global_config.yaml.
