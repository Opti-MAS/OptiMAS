# Copy to .env and set credentials for this server.
# The repository-root .env is also discovered when running from optimas_server/.
# Environment values override auth.api_keys and session.secret_key in config.yaml.
MCP_API_KEY="optimas-local-dev-key"
OPTIMAS_SESSION_SECRET=""
NO_PROXY="127.0.0.1,localhost,::1"

# Host, port, storage paths, logging and dashboard are configured in config.yaml.
